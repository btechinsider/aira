# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# GitHub Configuration
GITHUB_TOKEN=github_pat_your_token_here
GITHUB_REPO=owner/repo

# Slack Configuration (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Redis Configuration
# For local development (Docker)
REDIS_URL=redis://redis:6379
# For Render deployment (automatically set by Render)
# REDIS_URL=redis://red-xxxxx:6379

# Database Configuration
# For local development (SQLite)
DATABASE_URL=sqlite:///./aira.db

# For production with Supabase (PostgreSQL) - RECOMMENDED
# Get this from your Supabase project settings -> Database -> Connection String
# DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# For Render managed PostgreSQL (alternative)
# Render automatically provides this via DATABASE_URL environment variable
# DATABASE_URL=postgresql://user:password@host:5432/database

# MCP Server URLs
# For local Docker development
GITHUB_MCP_URL=http://github-mcp:8000
INCIDENT_CONTEXT_MCP_URL=http://incident-context-mcp:8000

# For Render deployment (use your service URLs)
# GITHUB_MCP_URL=https://aira-github-mcp.onrender.com
# INCIDENT_CONTEXT_MCP_URL=https://aira-incident-context-mcp.onrender.com

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production-use-long-random-string

# Frontend Configuration
# For local development
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# For Render deployment (use your backend service URL)
# VITE_API_URL=https://aira-backend.onrender.com
# VITE_WS_URL=wss://aira-backend.onrender.com/ws

# Frontend App Configuration
VITE_APP_NAME=AIRA
VITE_APP_VERSION=1.0.0

# Logging Configuration (Optional)
LOG_LEVEL=INFO